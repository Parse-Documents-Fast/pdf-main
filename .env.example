# pdf-main configuration (see internal/config/config.go).
# Copy to .env to override the defaults:  cp .env.example .env

# Internal listen address (behind Traefik, not exposed to the host)
HTTP_ADDR=:8000

# Base URLs of the downstream services
VALIDATOR_URL=http://pdf-validator:8000
PERSISTENCE_URL=http://pdf-persistence:8000
CONVERTER_URL=http://pdf-converter:8000
EXTRACTOR_URL=http://pdf-extractor:8000

# Redis queue address (pdf-infra)
REDIS_QUEUE_ADDR=redis-queue:6379

# Upload size limit in megabytes
MAX_FILE_SIZE_MB=10
