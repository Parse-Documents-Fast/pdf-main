# pdf-main configuration (see internal/config/config.go).
# Copy to .env to override the defaults:  cp .env.example .env

# Internal listen address (behind Traefik, not exposed to the host)
HTTP_ADDR=:8000

# Number of replicas 
PDF_MAIN_REPLICAS=5

# Base URLs of the downstream services
VALIDATOR_URL=http://pdf-validator:8000
PERSISTENCE_URL=http://pdf-persistence:8000
CONVERTER_URL=http://pdf-converter:8000
EXTRACTOR_URL=http://pdf-extractor:8000

# Redis queue address (pdf-infra)
REDIS_QUEUE_ADDR=redis-queue:6379

# Redis Streams (must match those in pdf-extractor; see ADR-0004)
REDIS_STREAM_EXTRACTION=queue:extraction
REDIS_STREAM_EXTRACTION_RESULTS=queue:extraction-results
REDIS_CONSUMER_GROUP=pdf-main

# Unique name per replica. Do not define it: the container hostname is used.
# CONSUMER_NAME=

# Log level: debug, info, warn or error (default: info).
LOG_LEVEL=info

# Upload size limit in megabytes (ADR-0008: single system value of 20 MB)
MAX_FILE_SIZE_MB=20
